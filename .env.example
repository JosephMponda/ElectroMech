# Deliver quote-form submissions by email. Create a free form at formspree.io or web3forms.com
# and paste the endpoint here (copy this file to .env.local for local testing, or set it in your host's build settings).
NEXT_PUBLIC_FORM_ENDPOINT=
# Only needed for Web3Forms (its access key). Leave empty for Formspree.
NEXT_PUBLIC_FORM_ACCESS_KEY=
